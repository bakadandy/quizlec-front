{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/components",
    "outDir": "dist/types",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/components/ui.tsx"]
}
